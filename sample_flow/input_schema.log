        "required": [
          "field"
        ],
        "additionalProperties": false
      },
      "description": "Sort order for results"
    },
    "limit": {
      "type": "number",
      "minimum": 1,
      "maximum": 500,
      "description": "Maximum number of records to retrieve (1-500)"
    },
    "offset": {
      "type": "number",
      "minimum": 0,
      "description": "Number of records to skip"
    }
  },
  "required": [
    "app"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
