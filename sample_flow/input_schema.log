=== Tool 'kintone-update-statuses' inputSchema ===
{
  "type": "object",
  "properties": {
    "app": {
      "type": "string",
      "description": "The ID of the app (numeric value as string)"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Record ID (numeric value as string)"
          },
          "action": {
            "type": "string",
            "description": "Action name to execute. Must be specified in the user's display language if multiple languages are configured. If multiple actions with the same name exist for the current status, an error will occur."
          },
          "assignee": {
            "type": "string",
            "description": "User login name to assign as the assignee. Required when: 1) The destination status has 'Select assignee from these users' enabled and selectable users exist, 2) Setting an assignee for the initial status when returning to it."
          },
          "revision": {
            "type": "string",
            "description": "Expected revision number (numeric value as string). If it doesn't match the actual revision, an error occurs and status is not updated. Specify -1 or omit to skip revision validation."
          }
        },
        "required": [
          "id",
          "action"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100,
      "description": "Array of records to update status (min 1, max 100). Each record contains id, action, and optionally assignee and revision."
    }
  },
  "required": [
    "app",
    "records"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
